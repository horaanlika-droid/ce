# ────────────────────────────────────────────────────────────────
#  Cocktail Embassy — переменные окружения
#
#  ОБЯЗАТЕЛЬНО ВВОДИТЬ (всего 2 переменные):
#     BOT_TOKEN   — токен бота от @BotFather
#     ADMIN_IDS   — ваш Telegram ID (и ID совладельцев) через запятую
#
#  Всё остальное — опционально: у каждого значения есть разумный
#  дефолт или оно определяется автоматически:
#   - публичный URL: подхватывается из домена хостинга / из первого
#     запроса к витрине (PUBLIC_URL нужен только для своего домена);
#   - имя бота: определяется самим ботом из getMe;
#   - порт: PORT, если хостинг его задаёт, иначе 80/3000/8080;
#   - режим Telegram: polling по умолчанию (вебхук не настраивать).
# ────────────────────────────────────────────────────────────────

# ── Обязательные ─────────────────────────────────────────────────
BOT_TOKEN=
# ID через запятую, узнать свой: @userinfobot. Пример: 123456789,987654321
ADMIN_IDS=

# ── Опциональные: сервер (обычно не трогать) ─────────────────────
# Публичный HTTPS-адрес (без слэша на конце). Ничего не вводите, если
# домен выдаёт хостинг — он определится сам. Вводите, только если
# подключили свой домен.
PUBLIC_URL=
# Порт, если хостинг прописывает свой (у Bothost задаётся платформой).
PORT=
# Каталог данных. Укажите точку монтирования volume хостинга, чтобы
# заказы переживали перезапуски (требует тарифа с Volume).
DATA_DIR=
# all | web | bot — всё вместе по умолчанию
MODE=all

# ── Опциональные: Telegram (polling по умолчанию — не трогать) ──
# webhook | polling. Для webhook нужны PUBLIC_URL и TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# Имя бота без @. Обычно не нужно — бот определит его сам.
BOT_USERNAME=

# ── Опциональные: оплата картой (ЮKassa) ─────────────────────────
# Без ключей витрина продаёт через proforma-счёт и оплату по
# подтверждению менеджера.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
YOOKASSA_RECEIPT=1

# ── Опциональные: реквизиты продавца (для счёта) ─────────────────
# По умолчанию достаточно для Dubai; замените под себя при желании
# (или прямо в админке бота: /admin → Магазин → Реквизиты счёта).
SELLER_NAME=Cocktail Embassy
SELLER_LEGAL_NAME=
SELLER_TRN=
SELLER_ADDRESS=Dubai, UAE
SELLER_BANK_NAME=
SELLER_IBAN=
SELLER_SWIFT=
SELLER_SIGNER=
SELLER_PHONE=+971 56 238 8262
SELLER_EMAIL=
INVOICE_PREFIX=CE-
# НДС в счёте: none | 5
INVOICE_VAT=none

# ── Опциональные: магазин (цены в AED; меняются и в админке) ─────
FREE_SHIPPING_FROM=1500
SHIPPING_COST=35
MIN_ORDER_TOTAL=0
