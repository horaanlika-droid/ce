# ────────────────────────────────────────────────────────────────
#  Cocktail Embassy — переменные окружения
#  Все значения задаются в панели хостинга — в коде их нет.
# ────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────
BOT_TOKEN=
ADMIN_IDS=
# Публичный HTTPS-адрес приложения (без слэша на конце)
PUBLIC_URL=
# Имя бота без @ (для ссылок вида t.me/<bot>?startapp=...)
BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# ── Сервер ───────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
EXTRA_PORTS=3000,8080
MODE=all

# ── Эквайринг (опционально: карта онлайн) ────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
YOOKASSA_RECEIPT=1

# ── Реквизиты продавца (для счёта / proforma invoice) ────────────
SELLER_NAME=Cocktail Embassy
SELLER_LEGAL_NAME=
SELLER_TRN=
SELLER_ADDRESS=Dubai, UAE
SELLER_BANK_NAME=
SELLER_IBAN=
SELLER_SWIFT=
SELLER_SIGNER=
SELLER_PHONE=+971 56 238 8262
SELLER_EMAIL=
INVOICE_PREFIX=CE-
# НДС в счёте: none | 5
INVOICE_VAT=none

# ── Магазин (цены в AED) ─────────────────────────────────────────
FREE_SHIPPING_FROM=1500
SHIPPING_COST=35
MIN_ORDER_TOTAL=0
